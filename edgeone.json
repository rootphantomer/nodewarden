{
  "buildCommand": "npm run build && npm run build:edgeone",
  "outputDirectory": "./dist",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cloudFunctions": {
    "nodejs": {
      "externalNodeModules": [
        "mysql2"
      ],
      "maxDuration": 60
    }
  }
}
